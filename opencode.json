{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "rm *", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "catalog": {
        "type": "local",
        "command": [
          "sh",
          "mcp/catalog-server-java/run.sh"
        ],
        "environment": {
          "CATALOG_BASE_URL": "http://localhost:8080"
        }
      }
    }
  }
}
